# Configuración de la IA de apuntes.
#
# 1. Copia este fichero como .env (en la carpeta donde uses apuntes)
#    o como ~/.config/apuntes/.env (para todas las carpetas).
# 2. Pon tu clave. Se crea en https://console.anthropic.com → API keys.
#
# .env está en .gitignore: NUNCA se sube al repositorio. No compartas tu clave.
# Sin clave, apuntes funciona igual con todas las acciones que no usan IA.

ANTHROPIC_API_KEY=

# Opcional: modelo de Claude. Por defecto, claude-opus-5-5.
# APUNTES_MODELO=claude-opus-5-5
